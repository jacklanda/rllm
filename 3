#!/bin/bash
set -xeuo pipefail

# ============================================================================
# Simplified Training Script with Git Management
# ============================================================================

TIMESTAMP=$(date +"%Y%m%d%H%M%S")
#EXPERIMENT_NAME="gem-dapo-4b-retry128-w-mini-retrieval"
#EXPERIMENT_NAME="gem-dapo-4b-retry128-w-wiki-retrieval"
#EXPERIMENT_NAME="asearcher-dapo-4b-retry128-w-mini-retrieval"
#EXPERIMENT_NAME="asearcher-dapo-4b-retry128-w-mini-retrieval"
#EXPERIMENT_NAME="asearcher-dapo-4b-retry128-w-wiki-retrieval"

#EXPERIMENT_NAME="hotpotqa-dapo-8b-w-v3-retrieval"
EXPERIMENT_NAME="hotpotqa-gdpo-4b-w-v4-retrieval-v7"
#EXPERIMENT_NAME="asearcher-dapo-4b-w-v3-retrieval"
#EXPERIMENT_NAME="asearcher-dapo-4b-w-v3-retrieval"
#EXPERIMENT_NAME="asearcher-dapo-4b-w-v3-retrieval-opt"
#EXPERIMENT_NAME="asearcher-dapo-4b-w-wiki-retrieval"
#EXPERIMENT_NAME="asearcher-dapo-8b-retry64-w-wiki-retrieval"
#EXPERIMENT_NAME="gem-dapo-8b-w-v3-retrieval-opt"

# ============================================================================
# Key Hyperparameters
# ============================================================================

algorithm="gdpo"
#adv_estimator="rloo_vectorized"

#algorithm="gdpo"
adv_estimator="gdpo"
#adv_estimator="gdpo"
train_batch_size=512
val_batch_size=512
max_prompt_length=2048
max_response_length=4096  # 2048 tokens / step * 16 steps = 32768 max total length
filter_overlong_prompts=True
filter_overlong_prompts_workers=32
#model_path="/share/nlp/share/plm/Qwen3-4B-Thinking-2507"
model_path="/share/nlp/share/plm/Qwen3-4B"
#model_path="/share/nlp/share/plm/Qwen3-4B-Base"
#model_path="/share/nlp/share/plm/Qwen3-4B-Instruct-2507"
#model_path="/share/nlp/share/plm/Qwen3-8B"
hybrid_engine=True
learning_rate=1e-6
min_lr_ratio=1e-7
lr_warmup_steps=10
weight_decay=0.05
warmup_style=cosine
use_remove_padding=True
loss_agg_mode=seq-mean-token-sum
ppo_mini_batch_size=256
use_dynamic_bsz=True
ppo_max_token_len_per_gpu=131072
use_kl_loss=False
clip_ratio_high=0.28
clip_ratio_low=0.2
clip_ratio_c=10.0
kl_loss_coef=0.001
kl_loss_type=low_var_kl
ulysses_sequence_parallel_size=8
use_liger=False
use_fused_kernels=True
enable_gradient_checkpointing=True
param_offload=True
optimizer_offload=True
fsdp_size=-1
tensor_model_parallel_size=1
rollout_name=vllm
rollout_mode="async"
enforce_eager=False
temperature=1.0
top_p=1.0
gpu_memory_utilization=0.8
rollout_n=16
val_n=1
val_temperature=1.0
val_top_p=1.0
val_top_k=20
val_do_sample=True
log_prob_micro_batch_size_per_gpu=8
toolcall_bonus=0
apply_repetition_penalty=False
repetition_penalty_weight=0
enable_rejection_sample=True
enable_trajectory_filtering=False
max_step_retries=2
max_tool_calls_per_turn=4
max_search_turns=32
entropy_coeff=0.01
strategy=fsdp2
grad_clip=1.0
entropy_from_logits_with_chunking=False
kl_coef=0
mask_truncated_samples=True
critic_warmup=0
logger_types=['console','wandb']
#logger_types=['console']
project_name='SearchRL'
total_epochs=100
resume_mode=auto
val_before_train=False
balance_batch=False
n_gpus=8
nnodes=1
save_freq=10
test_freq=10
default_hdfs_dir=null
max_steps=64

# ============================================================================
# Git Checkpoint
# ============================================================================

echo -e "Training Run: ${EXPERIMENT_NAME}"

# Check git status
if [[ -n $(git status -s) ]]; then
    echo -e "Committing changes..."
    git add -A
    
    # Generate commit message using gemini
    DIFF_CONTENT=$(git diff --cached)
    COMMIT_MSG=$(gemini -p "Summarize the following git diff very very concisely (if long, use bullets):
${DIFF_CONTENT}")
    
    git commit -m "[TRAINING] ${EXPERIMENT_NAME} @ ${TIMESTAMP} : ${COMMIT_MSG}"
    echo -e "✓ Changes committed"
fi

# Save commit hash and create tag
COMMIT_HASH=$(git rev-parse --short HEAD)
echo "${COMMIT_HASH}" > .last_training_commit

TAG_NAME="train/${EXPERIMENT_NAME}/${TIMESTAMP}"
git tag -a "${TAG_NAME}" -m "Training: ${EXPERIMENT_NAME} | ${TIMESTAMP}"
echo -e "✓ Tag created: ${TAG_NAME}"
echo -e "Commit: ${COMMIT_HASH}"

# ============================================================================
# Environment Setup
# ============================================================================

echo -e "\nSetting up environment..."

unset HIP
unset ROCR_VISIBLE_DEVICES
unset CUDA_VISIBLE_DEVICES
export CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7

#export NCCL_DEBUG=INFO
export NCCL_IB_DISABLE=1
export NCCL_TIMEOUT=3600
export RAY_ACCEL_ENV_VAR_OVERRIDE_ON_ZERO=0
export VLLM_ATTENTION_BACKEND=FLASH_ATTN
export PYTORCH_CUDA_ALLOC_CONF="expandable_segments:False"
export VLLM_USE_V1=1
export VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
export VLLM_ENGINE_ITERATION_TIMEOUT_S=100000000000
export VLLM_WORKER_MULTIPROC_METHOD=spawn
export TOKENIZERS_PARALLELISM=false
export RETRIEVAL_SERVER_URL="http://10.2.152.50:65432"

#ray stop --force 2>/dev/null || true
#unset RAY_ADDRESS RAY_REDIS_ADDRESS RAY_JOB_ID
#ray start --head --dashboard-host=0.0.0.0 --port=8964 --num-cpus=32 --temp-dir=/share/nlp/liuyang/tmp --disable-usage-stats

# ============================================================================
# Start Training
# ============================================================================

echo -e "Starting training...\n"

HOST=$(ip a | grep -oP 'inet \K[\d.]+' | grep ^10\.141\.)

RAY_ADDRESS="http://${HOST}:8265" \
ray job submit \
    --runtime-env=experiments/runtime_env.yaml \
    --working-dir . \
    -- \
    python3 -m examples.search.train_search_agent \
        algorithm.adv_estimator=${adv_estimator} \
        algorithm.kl_ctrl.kl_coef=${kl_coef} \
        data.train_batch_size=${train_batch_size} \
        data.val_batch_size=${val_batch_size} \
        data.max_prompt_length=${max_prompt_length} \
        data.max_response_length=${max_response_length} \
        data.filter_overlong_prompts=${filter_overlong_prompts} \
        data.filter_overlong_prompts_workers=${filter_overlong_prompts_workers} \
        actor_rollout_ref.hybrid_engine=${hybrid_engine} \
        actor_rollout_ref.actor.optim.lr=${learning_rate} \
        actor_rollout_ref.actor.optim.min_lr_ratio=${min_lr_ratio} \
        actor_rollout_ref.actor.optim.lr_warmup_steps=${lr_warmup_steps} \
        actor_rollout_ref.actor.optim.weight_decay=${weight_decay} \
        actor_rollout_ref.actor.optim.warmup_style=${warmup_style} \
        actor_rollout_ref.actor.loss_agg_mode=${loss_agg_mode} \
        actor_rollout_ref.actor.ppo_mini_batch_size=${ppo_mini_batch_size} \
        actor_rollout_ref.actor.use_dynamic_bsz=${use_dynamic_bsz} \
        actor_rollout_ref.actor.ppo_max_token_len_per_gpu=${ppo_max_token_len_per_gpu} \
        actor_rollout_ref.actor.use_kl_loss=${use_kl_loss} \
        actor_rollout_ref.actor.clip_ratio_high=${clip_ratio_high} \
        actor_rollout_ref.actor.clip_ratio_low=${clip_ratio_low} \
        actor_rollout_ref.actor.clip_ratio_c=${clip_ratio_c} \
        actor_rollout_ref.actor.kl_loss_coef=${kl_loss_coef} \
        actor_rollout_ref.actor.kl_loss_type=${kl_loss_type} \
        actor_rollout_ref.actor.ulysses_sequence_parallel_size=${ulysses_sequence_parallel_size} \
        actor_rollout_ref.actor.strategy=${strategy} \
        actor_rollout_ref.actor.entropy_coeff=${entropy_coeff} \
        actor_rollout_ref.actor.grad_clip=${grad_clip} \
        actor_rollout_ref.actor.entropy_from_logits_with_chunking=${entropy_from_logits_with_chunking} \
        actor_rollout_ref.actor.fsdp_config.fsdp_size=${fsdp_size} \
        actor_rollout_ref.actor.fsdp_config.param_offload=${param_offload} \
        actor_rollout_ref.actor.fsdp_config.optimizer_offload=${optimizer_offload} \
        actor_rollout_ref.model.path=${model_path} \
        actor_rollout_ref.model.use_remove_padding=${use_remove_padding} \
        actor_rollout_ref.model.use_liger=${use_liger} \
        actor_rollout_ref.model.use_fused_kernels=${use_fused_kernels} \
        actor_rollout_ref.model.enable_gradient_checkpointing=${enable_gradient_checkpointing} \
        actor_rollout_ref.rollout.tensor_model_parallel_size=${tensor_model_parallel_size} \
        actor_rollout_ref.rollout.name=${rollout_name} \
        actor_rollout_ref.rollout.mode=${rollout_mode} \
        actor_rollout_ref.rollout.enforce_eager=${enforce_eager} \
        actor_rollout_ref.rollout.temperature=${temperature} \
        actor_rollout_ref.rollout.top_p=${top_p} \
        actor_rollout_ref.rollout.gpu_memory_utilization=${gpu_memory_utilization} \
        actor_rollout_ref.rollout.n=${rollout_n} \
        actor_rollout_ref.rollout.log_prob_micro_batch_size_per_gpu=${log_prob_micro_batch_size_per_gpu} \
        actor_rollout_ref.rollout.val_kwargs.n=${val_n} \
        actor_rollout_ref.rollout.val_kwargs.temperature=${val_temperature} \
        actor_rollout_ref.rollout.val_kwargs.top_p=${val_top_p} \
        actor_rollout_ref.rollout.val_kwargs.top_k=${val_top_k} \
        actor_rollout_ref.rollout.val_kwargs.do_sample=${val_do_sample} \
        actor_rollout_ref.ref.log_prob_micro_batch_size_per_gpu=${log_prob_micro_batch_size_per_gpu} \
        actor_rollout_ref.ref.fsdp_config.param_offload=${param_offload} \
        trainer.critic_warmup=${critic_warmup} \
        trainer.logger=${logger_types} \
        trainer.project_name=${project_name} \
        trainer.experiment_name=${EXPERIMENT_NAME} \
        trainer.val_before_train=${val_before_train} \
        trainer.balance_batch=${balance_batch} \
        trainer.n_gpus_per_node=${n_gpus} \
        trainer.nnodes=${nnodes} \
        trainer.test_freq=${test_freq} \
        trainer.save_freq=${save_freq} \
        trainer.log_episodes=True \
        trainer.default_hdfs_dir=${default_hdfs_dir} \
        trainer.total_epochs=${total_epochs} \
        trainer.resume_mode=${resume_mode} \
        reward.toolcall_bonus=${toolcall_bonus} \
        reward.apply_repetition_penalty=${apply_repetition_penalty} \
        reward.repetition_penalty_weight=${repetition_penalty_weight} \
        rllm.rejection_sample.enable=${enable_rejection_sample} \
        rllm.trajectory_filtering.enable=${enable_trajectory_filtering} \
        rllm.trajectory_filtering.max_step_retries=${max_step_retries} \
        rllm.trajectory_filtering.max_tool_calls_per_turn=${max_tool_calls_per_turn} \
        rllm.trajectory_filtering.max_search_turns=${max_search_turns} \
        rllm.trajectory_filtering.max_tokens=${max_response_length} \
        rllm.mask_truncated_samples=${mask_truncated_samples} \
        rllm.agent.max_steps=${max_steps}

echo -e "✓ Training completed!"
